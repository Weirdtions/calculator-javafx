<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Background?>
<?import javafx.scene.layout.BackgroundFill?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="420.0" prefWidth="320.0" spacing="12.0"
      xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="com.example.javafxexample.HelloController">
    <fx:define>
        <Background fx:id="numberBackground">
            <fills>
                <BackgroundFill fill="#eee8f7" />
            </fills>
        </Background>
        <Background fx:id="operatorBackground">
            <fills>
                <BackgroundFill fill="#dce8f2" />
            </fills>
        </Background>
        <Background fx:id="equalsBackground">
            <fills>
                <BackgroundFill fill="#dcebdc" />
            </fills>
        </Background>
        <Font fx:id="buttonFont" size="18.0" />
    </fx:define>
    <background>
        <Background>
            <fills>
                <BackgroundFill fill="#f5f1ed" />
            </fills>
        </Background>
    </background>
    <padding>
        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
    </padding>

    <VBox spacing="6.0">
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        <TextField fx:id="formulaField" alignment="CENTER_RIGHT" editable="false"
                   focusTraversable="false" minHeight="28.0" prefHeight="28.0" maxHeight="28.0" opacity="0.6">
            <font>
                <Font size="15.0" />
            </font>
        </TextField>
        <TextField fx:id="TextField" alignment="CENTER_RIGHT" editable="false"
                   focusTraversable="false" minHeight="64.0" prefHeight="64.0" maxHeight="64.0"
                   text="0">
            <font>
                <Font size="42.0" />
            </font>
        </TextField>
    </VBox>

    <GridPane hgap="6.0" vgap="6.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="25.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="40.0" percentHeight="25.0" vgrow="ALWAYS" />
            <RowConstraints minHeight="40.0" percentHeight="25.0" vgrow="ALWAYS" />
            <RowConstraints minHeight="40.0" percentHeight="25.0" vgrow="ALWAYS" />
            <RowConstraints minHeight="40.0" percentHeight="25.0" vgrow="ALWAYS" />
        </rowConstraints>
        <children>
            <Button fx:id="Button7" text="7" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" />
            <Button fx:id="Button8" text="8" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="1" />
            <Button fx:id="Button9" text="9" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="2" />
            <Button fx:id="ButtonDiv" text="÷" background="$operatorBackground" font="$buttonFont" accessibleText="Divide" onAction="#insertOperator" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="3" />

            <Button fx:id="Button4" text="4" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.rowIndex="1" />
            <Button fx:id="Button5" text="5" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="Button6" text="6" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button fx:id="ButtonTimes" text="×" background="$operatorBackground" font="$buttonFont" accessibleText="Multiply" onAction="#insertOperator" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Button fx:id="Button1" text="1" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.rowIndex="2" />
            <Button fx:id="Button2" text="2" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="Button3" text="3" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button fx:id="ButtonMinus" text="−" background="$operatorBackground" font="$buttonFont" accessibleText="Subtract" onAction="#insertOperator" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Button fx:id="Button0" text="0" background="$numberBackground" font="$buttonFont" onAction="#insertNumber" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.rowIndex="3" />
            <Button fx:id="ButtonDot" text="." background="$numberBackground" font="$buttonFont" accessibleText="Decimal point" onAction="#insertDecimal" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button fx:id="ButtonEquals" text="=" background="$equalsBackground" font="$buttonFont" accessibleText="Equals" onAction="#insertOperator" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button fx:id="ButtonSum" text="+" background="$operatorBackground" font="$buttonFont" accessibleText="Add" onAction="#insertOperator" mnemonicParsing="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="3" />
        </children>
    </GridPane>
</VBox>
